# ── NEXUS Backend Environment ─────────────────────────────────────────────
# Copy this file to .env and fill in what you have.
# NEXUS runs in explicit DEMO MODE when no LLM credentials are present.

# Database (defaults to backend/nexus.db)
DATABASE_URL=sqlite:///./nexus.db

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────
# Leave blank to run in demo mode with deterministic agents.
LLM_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure gateway, Groq, OpenRouter, local vLLM, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# Force deterministic demo mode even if credentials exist: true / false
DEMO_MODE=false

# ── Telegram ──────────────────────────────────────────────────────────────
# Get a token from @BotFather. Leave blank to disable the bot.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated allow-list of chat IDs, e.g. 123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional fallback chat for approvals triggered from the web dashboard
TELEGRAM_DEFAULT_CHAT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
